{
  "$defs": {
    "CoordinateFrameWire": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "const": "source",
          "default": "source",
          "title": "Name",
          "type": "string"
        },
        "width": {
          "minimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "CoordinateFrameWire",
      "type": "object"
    },
    "EstimateWire": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "truth_class": {
          "enum": [
            "observed",
            "derived",
            "pooled"
          ],
          "title": "Truth Class",
          "type": "string"
        },
        "frame": {
          "const": "source",
          "default": "source",
          "title": "Frame",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "evidence_pages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Pages",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "confidence": {
          "default": null,
          "title": "Confidence",
          "type": "null"
        },
        "confidence_kind": {
          "const": "uncalibrated",
          "default": "uncalibrated",
          "title": "Confidence Kind",
          "type": "string"
        }
      },
      "required": [
        "name",
        "unit",
        "truth_class",
        "method",
        "sample_count"
      ],
      "title": "EstimateWire",
      "type": "object"
    },
    "ImageMetadataWire": {
