{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "strict": false
    },
    "MD022": false,
    "MD031": false,
    "MD040": false,
    "MD060": false
  },
  "ignores": [
    "docs/archive/**",
    // docgraph retires documents into docs/_archive/ and prepends its own
    // "Retired — superseded by" banner above the title, which MD041 rejects.
    "docs/_archive/**"
  ]
}
